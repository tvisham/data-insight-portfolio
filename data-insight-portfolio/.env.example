# Copy to .env and fill in as needed. Nothing here is required to run
# the tests or the offline demo.

# OpenAlex "polite pool" — an email address so they can contact you if
# your script misbehaves. Highly recommended.
OPENALEX_MAILTO=you@illinois.edu

# Path to the SQLite database file. Default is fine for local dev.
DATAHUB_DB_PATH=./datahub.db

# If you want the LLM tool-call agent to complement the rule-based one,
# set an OpenAI key. The rule-based agent works fine without it.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1  # override for Azure/local endpoints
